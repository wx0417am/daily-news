EMAIL_FROM=15827508425@163.com
EMAIL_TO=15827508425@163.com

# 163 邮箱 SMTP 授权码，不是登录密码
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_PASSWORD=replace_with_your_163_smtp_auth_code

# 兼容旧变量名（可选，仍可继续使用）
# QQ_SMTP_AUTH_CODE=replace_with_your_163_smtp_auth_code

# 可选：用于生成中英文摘要；未设置时使用 RSS 原文摘要
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
